# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env

POSTGRES_USER=fridge_monitor
POSTGRES_PASSWORD=fridge_monitor
POSTGRES_DB=fridge_monitor_db

# DATABASE_URL is built automatically in docker-compose.yml from the
# POSTGRES_* values above (via compose variable substitution), so it does
# not need to be set here. Shown for reference only — this is the shape
# backend/app/database.py expects if you ever need to override it:
# DATABASE_URL=postgresql+psycopg2://fridge_monitor:fridge_monitor@db:5432/fridge_monitor_db
